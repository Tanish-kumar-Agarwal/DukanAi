# docker-compose.yml variables (roadmap 7.3). Copy to .env (git-ignored) and
# set the two secrets; everything else has a local default.
#
#   cp .env.example .env
#   sed -i "s/^JWT_SECRET=.*/JWT_SECRET=$(openssl rand -hex 32)/; s/^NEXTAUTH_SECRET=.*/NEXTAUTH_SECRET=$(openssl rand -hex 32)/" .env
#   docker compose up --build -d --wait
#
# The API refuses to boot in production with a secret under 32 characters or
# one that still looks like a template value.
JWT_SECRET=
NEXTAUTH_SECRET=

# Where the browser reaches the two servers (CORS origin, NextAuth URL, the
# API URL inlined into the web bundle at build time).
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:3002/api
WEB_PORT=3000
API_PORT=3002

# MySQL 8 (the `migrate` service applies the migrations as this user).
MYSQL_DATABASE=dukaanai
MYSQL_USER=dukaanai
MYSQL_PASSWORD=dukaanai-local-only
MYSQL_ROOT_PASSWORD=root-local-only
API_DB_CONNECTION_LIMIT=20

# Observability (roadmap 7.6): the log level (production prints at most "log"),
# an optional bearer token for GET /api/metrics, the Sentry DSN (blank = off)
# and the release label stamped on tracked errors.
# `docker compose --profile ops up -d prometheus` scrapes the API with
# deploy/prometheus/prometheus.yml and loads deploy/prometheus/alerts.yml.
LOG_LEVEL=log
METRICS_TOKEN=
SENTRY_DSN=
APP_RELEASE=

# Backups (roadmap 7.7, 9.2, 9.3, 9.4; `docker compose --profile ops`):
# how many dumps and documents archives to keep, how long the binary-log
# archive keeps logs and how often the binlog-archiver service runs, and the
# off-site target: an rclone path (s3:bucket/dukaanai, b2:bucket/dukaanai,
# r2:bucket/dukaanai; the backend's credentials are RCLONE_CONFIG_<NAME>_*
# variables, see docs/BACKUP_RESTORE.md) plus the encryption key (32+
# characters; losing it loses every off-site copy: keep it in the secret
# store, never only here). Blank = `db-ops offsite` refuses with the reason.
BACKUP_KEEP=14
DOCUMENTS_BACKUP_KEEP=14
BINLOG_ARCHIVE_KEEP_DAYS=7
BINLOG_ARCHIVE_INTERVAL_SECONDS=300
OFFSITE_REMOTE=
OFFSITE_CRYPT_PASSWORD=
OFFSITE_CRYPT_SALT=
OFFSITE_KEEP_DAYS=30

# The edge (roadmap 9.8; `docker compose --profile edge up -d edge`, always on
# in docker-compose.prod.yml): the public hostnames Caddy serves and how it
# gets certificates. Blank EDGE_TLS_LINE = automatic public certificates
# (real DNS names, ports 80/443 reachable from the internet); "tls internal"
# = Caddy's own CA for local work and the smoke. With the edge in front set
# WEB_ORIGIN=https://<WEB_HOST> and API_PUBLIC_URL=https://<API_HOST>/api.
WEB_HOST=app.localhost
API_HOST=api.localhost
EDGE_TLS_LINE=tls internal
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
EDGE_MAX_BODY=64MB
EDGE_UPSTREAM_TIMEOUT=60s

# Production variant only (docker-compose.prod.yml, roadmap 9.7): the managed
# database over TLS (`?sslaccept=strict`; add `&sslcert=/etc/dukaanai/db-ca.pem`
# and set DB_CA_FILE to the provider's CA file when it is not signed by a
# public CA), managed Redis (rediss:// for TLS), the cloud disk the documents
# live on (absolute paths; blank = named volumes), the proxy hop count and
# the backup agent (a backup user with RELOAD + REPLICATION CLIENT, or the
# application user with BACKUP_COORDINATES=skip).
DATABASE_URL=
DB_CA_FILE=
REDIS_URL=
STORAGE_PATH=
UPLOADS_PATH=
BACKUPS_PATH=
TRUST_PROXY=1
DB_OPS_DATABASE_URL=
BACKUP_COORDINATES=auto
BACKUP_LOOP_INTERVAL_SECONDS=86400
BACKUP_LOOP_INITIAL_DELAY_SECONDS=60

# Optional integrations (blank = feature off; invitations need SMTP in production).
SMTP_URL=
EMAIL_FROM=DukaanAI <no-reply@dukaanai.local>
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
