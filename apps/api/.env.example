################################################################################
# DUKAN AI ENTERPRISE ENVIRONMENT FILE
################################################################################

################################################################################
# APPLICATION
################################################################################
# Required: development, test or production. The start scripts set it; a
# process without it refuses to boot rather than run as development.
NODE_ENV=development
PORT=3002
FRONTEND_URL=http://localhost:3000
# Reverse proxies between the internet and the API (Express "trust proxy").
# false (default) trusts nothing: the socket address is the client and
# X-Forwarded-For is ignored. Set the number of proxy hops (e.g. 1 for one
# nginx / load balancer), or "loopback", "linklocal", "uniquelocal", or a
# comma-separated list of IPs / CIDR ranges. "true" trusts every hop and lets
# any client spoof its address: never use it in production. The web app is a
# proxy too: it forwards the browser's address on sign-in and refresh calls,
# so count it as a hop when it and the API share a host.
TRUST_PROXY=false

# Deployment (roadmap 7.3). On SIGTERM the readiness probe (GET /api/health/ready)
# answers 503 at once, the process waits SHUTDOWN_DRAIN_DELAY_MS for the load
# balancer to stop routing to it (0 under compose, a few seconds behind a
# Kubernetes Service), then stops listening, finishes in-flight requests and
# active jobs and closes BullMQ, Redis and Prisma. A drain still running after
# SHUTDOWN_TIMEOUT_MS exits 1; keep the orchestrator's grace period above the
# sum of the two. HTTP_KEEP_ALIVE_TIMEOUT_MS must exceed the idle timeout of
# the proxy in front (60 s on most) or it answers 502 on a reused connection.
# QUEUE_READY_TIMEOUT_MS bounds how long boot waits for the BullMQ connections
# before it listens anyway.
SHUTDOWN_TIMEOUT_MS=30000
SHUTDOWN_DRAIN_DELAY_MS=0
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
QUEUE_READY_TIMEOUT_MS=30000

################################################################################
# DATABASE
################################################################################
DATABASE_URL=mysql://root:password@localhost:3306/dukaanai
PRISMA_LOG_QUERIES=true
PRISMA_SLOW_QUERY_THRESHOLD=1000

################################################################################
# REDIS / QUEUE
################################################################################
REDIS_URL=redis://localhost:6379
QUEUE_CONCURRENCY=5
CACHE_TTL=3600000
CACHE_MAX_ITEMS=1000

# Background schedulers (cron expressions, 5 or 6 fields). CRON_ENABLED=false
# registers none of them; an expression with no upcoming run fails boot.
CRON_ENABLED=true
CRON_PURCHASE_OUTBOX_RELAY="* * * * * *"
CRON_EVENTS_OUTBOX_RELAY="*/5 * * * * *"
CRON_PRODUCT_OUTBOX_RELAY="* * * * * *"
CRON_INVENTORY_RECON="*/5 * * * *"
CRON_ANALYTICS_JOB="0 0 * * *"
CRON_BATCH_EXPIRY_SWEEP="0 * * * *"
CRON_RESERVATION_EXPIRY_SWEEP="* * * * *"

################################################################################
# AUTHENTICATION
################################################################################
# With NODE_ENV=production the secret must be real: at least 32 characters and
# no template placeholder, or the API refuses to boot. Signing is HS256.
JWT_SECRET=your_jwt_secret_generate_with_openssl
# Access tokens are short-lived and carry their session id, so a logout takes
# effect at once. JWT_REFRESH_EXPIRES_IN is the idle lifetime of a refresh
# token (rotated on every refresh); SESSION_ABSOLUTE_LIFETIME caps a session
# from its login however often it is refreshed. Durations: ms, s, m, h, d.
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SESSION_ABSOLUTE_LIFETIME=30d
BCRYPT_ROUNDS=10

# Outbound email (staff invitations carry their token by email only).
# SMTP_URL is a nodemailer transport URL, e.g. smtp://user:pass@smtp.example.com:587
# or smtps://... Unset: messages are logged instead of sent, and in production
# an invitation cannot be issued until it is set.
SMTP_URL=
EMAIL_FROM=DukaanAI <no-reply@dukaanai.local>

# DANGER: set to true ONLY to run the app with authentication fully disabled.
# Every request then runs as a provisioned system user (system@dukaanai.local)
# and the API logs a loud warning at startup. Accepts only true/1/yes/on (or
# false/0/no/off); an unrecognized value refuses to boot. Defaults to false
# (auth enabled) when unset. Accepted only when NODE_ENV is development or
# test: with NODE_ENV=production (or unset) the API refuses to boot.
AUTH_DISABLED=false

################################################################################
# SECURITY
################################################################################
SECURITY_MAX_LOGIN_ATTEMPTS=5
SECURITY_LOCKOUT_DURATION_MS=900000
# Per-client-IP request limits (@nestjs/throttler, counters in Redis so every
# API instance shares them). Windows are MILLISECONDS; anything under 1000 ms
# fails boot. The three general windows apply to every route; the
# AUTH_RATE_LIMIT_* limits replace them over the same windows on login,
# register, refresh, Google sign-in and invitation accept.
RATE_LIMIT_SHORT_TTL_MS=10000
RATE_LIMIT_SHORT_LIMIT=20
RATE_LIMIT_MEDIUM_TTL_MS=60000
RATE_LIMIT_MEDIUM_LIMIT=100
RATE_LIMIT_LONG_TTL_MS=3600000
RATE_LIMIT_LONG_LIMIT=1000
AUTH_RATE_LIMIT_SHORT_LIMIT=5
AUTH_RATE_LIMIT_MEDIUM_LIMIT=20
AUTH_RATE_LIMIT_LONG_LIMIT=100
# Login attempts per account (any address) per medium window before 429.
AUTH_RATE_LIMIT_ACCOUNT_LIMIT=10

################################################################################
# STORAGE
################################################################################
# Local document root (billing evidence). Relative values are resolved once at
# boot against the working directory (the start scripts run from apps/api);
# NODE_ENV=production refuses a relative or placeholder root (roadmap 7.5).
STORAGE_ROOT=./data/storage
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET=your_bucket
S3_PUBLIC_URL=https://cdn.example.com

################################################################################
# AI / OCR
################################################################################
GEMINI_API_KEY=your_gemini_api_key
OCR_FUZZY_MATCH_THRESHOLD=0.85
OCR_TIMEOUT_MS=30000
OCR_BACKOFF_MS=1000

################################################################################
# FEATURE FLAGS & TUNING
################################################################################
EVENTS_RECENT_LIMIT=50
EVENTS_WEBHOOK_DELIVERY_LIMIT=5
EVENTS_OUTBOX_PROCESSOR_BATCH_SIZE=100
IMPORT_EXPORT_LIST_LIMIT=50
INVENTORY_RECENT_ADJUSTMENTS_LIMIT=100
INVENTORY_RECENT_MOVEMENTS_LIMIT=100
INVENTORY_UNRESOLVED_ALERTS_LIMIT=50
INVENTORY_LIST_LIMIT=50
INVENTORY_RECON_BATCH_SIZE=1000
INVENTORY_RECON_LOCK_TTL_MS=300000
INVENTORY_MAX_PRINT_QUANTITY=1000
INVENTORY_RECON_LOOKBACK_MS=86400000
PURCHASE_DEAD_LETTER_PAGINATION_LIMIT=50
SALES_DEFAULT_PAGINATION_LIMIT=50
SALES_RECENT_EVENTS_LIMIT=100
SALES_CREDIT_HOLD_THRESHOLD=10000
SALES_DEFAULT_CREDIT_LIMIT=5000
SEARCH_FUZZY_CANDIDATE_LIMIT=100
SEARCH_RESULT_LIMIT=50
SEARCH_ANALYTICS_LIMIT=1000
SEARCH_HISTORY_MAX_PER_MINUTE=120
VALIDATION_DUPLICATE_SCAN_LIMIT=10

# --- Billing authority (defaults in src/config/domains/features/billing-feature.config.ts)
# Largest discount (percent, line / invoice / combined effective) a CASHIER may apply alone; 0..100.
BILLING_CASHIER_MAX_DISCOUNT_PERCENT=10
# Largest custom (free-priced) line amount, in rupees per line, a CASHIER may bill alone; 0 = cashiers cannot add custom lines.
BILLING_CASHIER_MAX_CUSTOM_LINE_AMOUNT=500

# Multipart uploads (roadmap 5.1): hard caps per file; uploads stream to UPLOAD_TEMP_DIR (relative to the working directory)
UPLOAD_MAX_MEDIA_BYTES=52428800
UPLOAD_MAX_IMPORT_BYTES=20971520
UPLOAD_TEMP_DIR=uploads/tmp
